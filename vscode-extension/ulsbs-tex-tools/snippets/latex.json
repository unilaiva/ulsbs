{
  "Chord definition (ULSBS)": {
    "prefix": "\\[",
    "body": "\\[${1}]",
    "description": "Insert \\[ ... ] (ULSBS). Place chord names and melody blocks within this."
  },

  "Chord definition with melody block (ULSBS)": {
    "prefix": "melodychord",
    "body": "\\[<${1:C}>${2:Chord}]$0",
    "description": "Insert a chord definition with a melody block: primary[;secondary][ @ offset]."
  },

  "Zero-advance chord definition with melody block (ULSBS)": {
    "prefix": "melodychordzero",
    "body": "\\[<!${1:C}>${2:Chord}]$0",
    "description": "Insert melody layers with zero advance; a following chord keeps its natural width."
  },

  "Unmemorized chord definition with melody block (ULSBS)": {
    "prefix": "melodychordskip",
    "body": "\\[^<${1:C}>${2:Chord}]$0",
    "description": "Insert a melody block excluded from chord memorization."
  },

  "Secondary melody position (ULSBS)": {
    "prefix": "melodySecondaryPosition",
    "body": "\\melodySecondaryPosition{${1|above,below,same|}}",
    "description": "Set the secondary melody position in the current TeX scope; same overlays the primary lane."
  },

  "Primary melody position (ULSBS)": {
    "prefix": "melodyPrimaryPosition",
    "body": "\\melodyPrimaryPosition{${1|normal,low|}}",
    "description": "Set the primary melody position in the current TeX scope; normal is the default."
  },

  "Melody style mapping (ULSBS)": {
    "prefix": "melodyStyleMapping",
    "body": "\\melodyStyleMapping{${1|normal,swapped|}}",
    "description": "Set the primary/secondary visual style mapping in the current TeX scope."
  },

  "begin{songs} ... end{songs} (ULSBS)": {
    "prefix": [ "begin{songs}", "\\begin{songs}" ],
    "body": [
      "\\begin{songs}",
      "\t$0",
      "\\end{songs}"
    ],
    "description": "Insert songs environment. Songs must be within songs environments."
  },


  "begin{translation} ... end{translation} (ULSBS)": {
    "prefix": [ "translation", "\\begin{translation}" ],
    "body": [
      "\\begin{translation}[$1]",
      "\t$0",
      "\\end{translation}"
    ],
    "description": "Insert translation environment"
  },

  "begin{explanation} ... end{explanation} (ULSBS)": {
    "prefix": [ "explanation", "\\begin{explanation}" ],
    "body": [
      "\\begin{explanation}[$1]",
      "\t$0",
      "\\end{explanation}"
    ],
    "description": "Insert explanation environment"
  },

  "begin{passage} ... end{passage} (ULSBS)": {
    "prefix": [ "passage", "\\begin{passage}" ],
    "body": [
      "\\begin{passage}[$1]",
      "\t$0",
      "\\end{passage}"
    ],
    "description": "Insert passage environment"
  },

  "begin{feeler} ... end{feeler} (ULSBS)": {
    "prefix": [ "feeler", "\\begin{feeler}" ],
    "body": [
      "\\begin{feeler}",
      "\t$0",
      "\\end{feeler}"
    ],
    "description": "Insert feeler environment"
  },

  "begin{lilypond} ... end{lilypond} (ULSBS)": {
    "prefix": [ "lilypond", "\\begin{lilypond}" ],
    "body": [
      "\\begin{lilypond}",
      "\t$0",
      "\\end{lilypond}"
    ],
    "description": "Insert lilypond environment"
  },

  "begin{lilywrap+lilypond} ... end{lilypond+lilywrap} (ULSBS)": {
    "prefix": [ "lilywrap", "\\begin{lilywrap}" ],
    "body": [
      "\\begin{lilywrap}\\begin{lilypond}",
      "\t$0",
      "\\end{lilypond}\\end{lilywrap}"
    ],
    "description": "Insert lilywrap + lilypond environment"
  }
}

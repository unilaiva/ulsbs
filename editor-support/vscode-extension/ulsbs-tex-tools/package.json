{
  "name": "ulsbs-tex-tools",
  "displayName": "ULSBS TeX Tools",
  "description": "Custom LaTeX support for ULSBS song macros",
  "version": "0.4.0",
  "publisher": "ulsbs",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Lari Natri",
    "email": "lari.natri@iki.fi"
  },
  "icon": "images/ulsbs-vscode-extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/unilaiva/ulsbs",
    "directory": "editor-support/vscode-extension/ulsbs-tex-tools"
  },
  "keywords": [
    "latex",
    "songbook",
    "lilypond",
    "ulsbs"
  ],
  "engines": {
    "vscode": "^1.138.0"
  },
  "main": "./extension.js",
  "browser": "./dist/web/extension.js",
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "latex",
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "latex",
        "path": "./snippets/latex.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "ulsbs.chord.injection.latex",
        "path": "./syntaxes/ulsbs-chord.injection.tmLanguage.json",
        "injectTo": [
          "text.tex.latex"
        ]
      }
    ],
    "commands": [
      {
        "command": "ulsbsTexTools.compileCurrentContext",
        "title": "ULSBS: Compile current context…",
        "icon": "$(play)"
      },
      {
        "command": "ulsbsTexTools.compileAllSongbooks",
        "title": "ULSBS: Compile all songbooks…",
        "icon": "$(run-all)"
      },
      {
        "command": "ulsbsTexTools.chooseCompileProfile",
        "title": "ULSBS: Choose compile profile",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ulsbsTexTools.refreshWorkspace",
        "title": "ULSBS: Refresh workspace index",
        "icon": "$(refresh)"
      },
      {
        "command": "ulsbsTexTools.openSongbook",
        "title": "ULSBS: Open songbook",
        "icon": "$(book)"
      },
      {
        "command": "ulsbsTexTools.compileSongbook",
        "title": "ULSBS: Compile this songbook",
        "icon": "$(play)"
      },
      {
        "command": "ulsbsTexTools.compileSongbookWithProfile",
        "title": "ULSBS: Compile this songbook with profile…",
        "icon": "$(settings-gear)"
      },
      {
        "command": "ulsbsTexTools.openPdfPreview",
        "title": "ULSBS: Open PDF Preview",
        "icon": "$(file-pdf)"
      },
      {
        "command": "ulsbsTexTools.compilePdfPreview",
        "title": "ULSBS: Build PDF Preview"
      },
      {
        "command": "ulsbsTexTools.syncToPdf",
        "title": "ULSBS: Sync Source to PDF"
      },
      {
        "command": "ulsbsTexTools.openConfig",
        "title": "ULSBS: Open configuration (ulsbs-config.toml)",
        "icon": "$(settings)",
        "category": "ULSBS"
      },
      {
        "command": "ulsbsTexTools.createSongbook",
        "title": "ULSBS: Create new songbook…",
        "icon": "$(add)",
        "category": "ULSBS"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ulsbs",
          "title": "ULSBS",
          "icon": "images/ulsbs-vscode-activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "ulsbs": [
        {
          "id": "ulsbsSongbooks",
          "name": "Songbooks",
          "icon": "images/ulsbs-vscode-activitybar-icon.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ulsbsTexTools.syncToPdf",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "ulsbsTexTools.enabled && editorTextFocus && editorLangId == latex"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ulsbsTexTools.openPdfPreview",
          "when": "ulsbsTexTools.enabled"
        },
        {
          "command": "ulsbsTexTools.compilePdfPreview",
          "when": "ulsbsTexTools.enabled"
        },
        {
          "command": "ulsbsTexTools.syncToPdf",
          "when": "ulsbsTexTools.enabled"
        }
      ],
      "editor/context": [
        {
          "command": "ulsbsTexTools.openPdfPreview",
          "when": "ulsbsTexTools.enabled && editorLangId == latex",
          "group": "navigation@9"
        },
        {
          "command": "ulsbsTexTools.syncToPdf",
          "when": "ulsbsTexTools.enabled && editorLangId == latex",
          "group": "navigation@10"
        },
        {
          "command": "ulsbsTexTools.compilePdfPreview",
          "when": "ulsbsTexTools.enabled && editorLangId == latex",
          "group": "navigation@11"
        }
      ],
      "explorer/context": [
        {
          "command": "ulsbsTexTools.openPdfPreview",
          "when": "ulsbsTexTools.enabled && resourceExtname == .pdf && !explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "ulsbsTexTools.compileCurrentContext",
          "when": "view == ulsbsSongbooks",
          "group": "navigation@1"
        },
        {
          "command": "ulsbsTexTools.refreshWorkspace",
          "when": "view == ulsbsSongbooks",
          "group": "navigation@2"
        },
        {
          "command": "ulsbsTexTools.compileAllSongbooks",
          "when": "view == ulsbsSongbooks",
          "group": "navigation@3"
        },
        {
          "command": "ulsbsTexTools.chooseCompileProfile",
          "when": "view == ulsbsSongbooks",
          "group": "navigation@4"
        },
        {
          "command": "ulsbsTexTools.openConfig",
          "when": "view == ulsbsSongbooks",
          "group": "navigation@5"
        },
        {
          "command": "ulsbsTexTools.createSongbook",
          "when": "view == ulsbsSongbooks",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "ulsbsTexTools.openSongbook",
          "when": "view == ulsbsSongbooks && viewItem == songbook",
          "group": "inline@1"
        },
        {
          "command": "ulsbsTexTools.compileSongbook",
          "when": "view == ulsbsSongbooks && viewItem == songbook",
          "group": "inline@2"
        },
        {
          "command": "ulsbsTexTools.compileSongbookWithProfile",
          "when": "view == ulsbsSongbooks && viewItem == songbook",
          "group": "navigation@1"
        },
        {
          "command": "ulsbsTexTools.openPdfPreview",
          "when": "view == ulsbsSongbooks && viewItem == songbook",
          "group": "inline@3"
        },
        {
          "command": "ulsbsTexTools.compilePdfPreview",
          "when": "view == ulsbsSongbooks && viewItem == songbook",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "ULSBS TeX Tools",
      "properties": {
        "ulsbsTexTools.buildPreviewOnSave": {
          "type": "boolean",
          "default": false,
          "description": "When a songbook source is saved, rebuild all open PDF preview variants for the affected books."
        },
        "ulsbsTexTools.enable": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "Enable ULSBS-specific features. 'auto' enables them only when a ULSBS workspace is detected."
        },
        "ulsbsTexTools.fileGlob": {
          "type": "string",
          "default": "**/*.*tex",
          "description": "Workspace glob for TeX-like documents."
        },
        "ulsbsTexTools.excludeGlob": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/temp/**",
            "**/ulsbs/assets/tex/**",
            "**/ulsbs-tex-tools/assets/**"
          ],
          "description": "Glob patterns for files and folders to exclude from ULSBS workspace scanning."
        },
        "ulsbsTexTools.songbookExcludeGlob": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional glob patterns to exclude from Songbooks view discovery. These are merged with the built-in exclusions for hidden directories, build directories, ulsbs/tests, and tests/fixtures, and do not disable editing features in matching files."
        },
        "ulsbsTexTools.compileCommand": {
          "type": "string",
          "default": "ulsbs/ulsbs-compile",
          "description": "Path to the ULSBS compile script, relative to the workspace root. The default also tries a root-level wrapper and then ulsbs-compile on PATH."
        },
        "ulsbsTexTools.askProfileOnCompile": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a ULSBS profile when compiling."
        },
        "ulsbsTexTools.defaultProfile": {
          "type": "string",
          "default": "default",
          "description": "Fallback profile when not asking interactively."
        },
        "ulsbsTexTools.autoRefreshDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Refresh ULSBS diagnostics automatically on edits and saves."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "compile-web": "node esbuild.web.mjs",
    "watch-web": "node esbuild.web.mjs --watch",
    "test:grammar": "node test/grammar-fixtures.js",
    "test:songbooks": "node test/songbook-exclusions.js",
    "test:verse": "node test/verse.js",
    "test:synctex": "node test/synctex.js",
    "test:builds": "node --test test/compile-builds.js",
    "test:preview": "node --test test/pdf-preview.js test/webview-pdf-word.mjs",
    "vscode:prepublish": "npm run typecheck && npm run compile-web",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/vscode": "1.138.0",
    "@unilarva/pdfjs-viewer": "0.10.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.5.438",
    "typescript": "~6.0.3"
  }
}

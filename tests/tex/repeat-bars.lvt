\input regression-test.tex
\documentclass[paper={a5paper},maintitle={Repeat Regression}]{ulsbs-songbook}
\begin{document}
\begin{ulSongs}{}
\beginsong{Repeat Regression}
  \beginverse
    \beginrep
      Outer line.
      \beginrep
        Nested line.
      \endrep
      Final outer line.
    \endrep
  \endverse
\endsong
\end{ulSongs}
\START
\makeatletter
\TYPE{engine=LuaTeX}
\TYPE{repeat-level=\the\ulsbs@rep@level}
\TYPE{repeat-occurrences=\the\ulsbs@rep@serial}
\ulRepeatBarContinuationDashLength=2pt
\ulRepeatBarContinuationDashGap=1.25pt
\TYPE{dash-length=\the\ulRepeatBarContinuationDashLength}
\TYPE{dash-gap=\the\ulRepeatBarContinuationDashGap}
\setbox0=\vbox{Marker before\par}
\ulsbs@rep@level=1
\expandafter\def\csname ulsbs@rep@id@1\endcsname{1}
\setbox2=\vbox{Marker before\par\ulsbs@rep@endmarker}
\ulsbs@rep@level=0
\TYPE{marker-height-delta=\the\dimexpr\ht2-\ht0\relax}
\TYPE{marker-depth-delta=\the\dimexpr\dp2-\dp0\relax}
\TYPE{marker-last-penalty=\the\lastpenalty}
\makeatother
\END
\end{document}

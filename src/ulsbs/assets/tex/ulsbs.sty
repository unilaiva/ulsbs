% optional parameters is used.
%
% The note is attached to the material after it (default), or to the matter
% after it (if first optional star is present). This means that column breaks do
% not happen between the note and the stuff it is attached to. Attachment is
% ignored if called from within a stanza.
%
% If the note is attached to the material after it, and called from outside of
% of stanzas, the \glueverses macro is called to remove the \vspace the
% beginning of the next verse in the current song would give. This might cause
% a problem if there is material between this note and the next stanza. In such
% a case one can attach the note to the material before, or add the second star
% to signify that \glueverses is never called from within this macro.
%
% Usage:
%
%   \attachednote*[vspace before][vspace after]{text}*
%
%   1st star:      This optional star signifies that the note is attached to the
%                  stuff before it. If it is omitted, the note is attached to
%                  the stuff coming after it.
%   vspace before: The amount of vspace added before the note. This is passed
%                  to \vspace, and can contain macros, for example:
%                  "0.5\ulVerseSep". Default: 0pt.
%   vspace after:  The amount of vspace added after the note. This is passed
%                  to \vspace, and can contain macros, for example:
%                  "0.5\ulVerseSep". Default: 0pt.
%   text:          The text content of the note.
%   2nd star:      If present, this star means that \glueverses is not called in
%                  any case.
%
% NOTE: If optional parameters are omitted, also the empty bracket pair must
%       be left out! So no "[]".
%
%
% Note: \NewDocumentCommand, IfValueTF etc. come from xparse package, and allow
%       nice handling of parameters.


% Creates a textual note attached to the material preceding it.
\newcommand{\textnoteforprev}[1]{%
  \attachednote*[0.618034\ulVerseSep][\ulVerseSep]{#1}%
}

% Creates a textual note attached to the material coming after it.
% Starred version omits glueverses. The starred version omits glueverses:
% use the star if before 1st verse.
\NewDocumentCommand{\textnotefornext}{m s}{%
  \IfBooleanTF{#2}{%
    \attachednote[\ulVerseSep][0.618034\ulVerseSep]{#1}*%
  }{%
    \attachednote[\ulVerseSep][0.618034\ulVerseSep]{#1}%
  }%
}%

% Creates a textual note in the middle of preceding and consequent material.
% It is attached to the material coming after it, but does not call \glueverses.
\newcommand{\textnotemiddle}[1]{%
  \attachednote[\ulVerseSep][\ulVerseSep]{#1}*%
}

% Creates a textual note in the middle of preceding and consequent material
% with smaller vertical space around it.
% It is attached to the material coming after it, but does not call \glueverses.
\newcommand{\textnotemiddletight}[1]{%
  \attachednote[0.618034\ulVerseSep][0.618034\ulVerseSep]{#1}*%
}

% Creates a music note attached to the material preceding it.
% Music notes are only displayed if chords are enabled, and in the same color
% as the chords.
\newcommand{\musicnoteforprev}[1]{%
  \ifulChorded\textnoteforprev{\color{ulChordColor}#1}\fi%
}

% Creates a music note attached to the material coming after it.
% Music notes are only displayed if chords are enabled, and in the same color
% as the chords. The starred version omits glueverses: use the star if before
% 1st verse.
\NewDocumentCommand{\musicnotefornext}{m s}{%
  \ifulChorded%
    \IfBooleanTF{#2}{%
      \textnotefornext{\color{ulChordColor}#1}*%
    }{%
      \textnotefornext{\color{ulChordColor}#1}%
    }%
  \fi%
}

% Creates a textual note in the middle of preceding and consequent material.
% It is attached to the material coming after it, but does not call \glueverses.
% Music notes are only displayed if chords are enabled, and in the same color
% as the chords.
\newcommand{\musicnotemiddle}[1]{%
  \ifulChorded\textnotemiddle{\color{ulChordColor}#1}\fi%
}

% Rewrite capo presentation to attach to the material coming after it, and to
% make it smaller than the default. Only shown if chords are enabled.
\DeclareDocumentCommand\capo{m}{%
  \ifulTransposeCapos\transpose{#1}\else%
    \ifulChorded%
      \attachednote[\ulVerseSep][0.618034\ulVerseSep]{\color{ulChordColor}\scriptsize capo #1}*
    \fi%
  \fi%
}

% === Line repeat bars ===

% Line repeat bars inside verses. This prints vertical repeat
% bars for the lyric lines within it's effect. Can be nested. Use only within
% verses
%
% Usage example:
%
%   \beginverse
%     lyric line without repeat
%     \beginrep
%       lyric line with one repeat level
%       lyric line with one repeat level (2nd line of the same repeat)
%       \beginrep
%         lyric line with two repeat levels
%       \endrep
%     \endrep
%   \endverse
%
% The verse machinery installed last supplies repeat lifecycle integration.

% Consumer settings: lengths/dimensions are initialized here; override them after
% loading with \setlength. Renew \ulRepeatBarContinuingOverlap after loading;
% unlike the dimensions, it evaluates the current baseline each time it is used.

% Repetition bar width (register provided by init).
\setlength{\ulRepeatBarWidth}{1.4pt}
% The horizontal gap between line repeat bars, and minimum gap between the
% last (deepest level) bar and the start of the lyrics
\newdimen\ulRepeatBarGap\ulRepeatBarGap=2.265pt

% NOTE: Be careful if changing the following settings. Test all situations:
% with chords, lyric-only, without measure bars. Separate bars following each
% must leave enough gap between them, and multiline repeat bars ought to have
% no gaps in between lyric lines.

% The amount the repetition bar reaches below baseline of the last lyric line
\newdimen\ulRepeatBarDepth\ulRepeatBarDepth=.5pt
\newdimen\ulRepeatBarHeightAdjustmentWithChords\ulRepeatBarHeightAdjustmentWithChords=-2.5pt
\newdimen\ulRepeatBarHeightAdjustmentNoChords\ulRepeatBarHeightAdjustmentNoChords=.5pt
% At a page/column break, add two short vertical dashes beyond each end of the
% solid bar. These dimensions control dash length and the gaps between the
% solid bar and dashes, and between the two dashes.
\newdimen\ulRepeatBarContinuationDashLength
\ulRepeatBarContinuationDashLength=2pt
\newdimen\ulRepeatBarContinuationDashGap
\ulRepeatBarContinuationDashGap=1.25pt
% How much extra upward reach continuation lines get to bridge interline glue
% when having multiline repeat bars.
\newcommand{\ulRepeatBarContinuingOverlap}{\the\dimexpr .7\baselineskip\relax}

% State: key->boolean map for
%        <repeat nesting level> -> <repeat started on previous line>
\ExplSyntaxOn
\prop_new:N \g__ulsbs_repeat_cont_prop
\ExplSyntaxOff

% State: Current line repeat bar's nesting depth.
% Updated by \beginrep and \endrep.
\newcount\ulsbs@rep@level\ulsbs@rep@level=0\relax%
% Give every repeat occurrence its own id. On LuaTeX the id is attached to
% its rule fragments, which are coalesced into one rule at shipout.
\newcount\ulsbs@rep@serial\ulsbs@rep@serial=0\relax%

% LuaTeX can alter the final node list after layout splits it into physical
% pages and columns. Group tagged fragments by repeat id and absolute x
% position, retain the uppermost rule, and extend it through the lowest one.
% A repeat crossing a page or column boundary is therefore represented by one
% rule in each resulting segment. Other engines keep the fragment fallback.
\ifdefined\directlua
  \directlua{
    --[[ Attributes survive boxing and page/column splitting. The primary
    attribute identifies a repeat occurrence; the others carry semantic
    endpoint and unsplit line-height information to the shipout callback. ]]
    local attribute = luatexbase.new_attribute("ulsbs.repeatbar")
    local start_attribute = luatexbase.new_attribute("ulsbs.repeatbar.start")
    local end_attribute = luatexbase.new_attribute("ulsbs.repeatbar.end")
    local height_attribute = luatexbase.new_attribute("ulsbs.repeatbar.height")
    token.set_macro("ulsbs@rep@attribute", tostring(attribute), "global")
    token.set_macro("ulsbs@rep@startattribute", tostring(start_attribute), "global")
    token.set_macro("ulsbs@rep@endattribute", tostring(end_attribute), "global")
    token.set_macro("ulsbs@rep@heightattribute", tostring(height_attribute), "global")

    local hlist_id = node.id("hlist")
    local vlist_id = node.id("vlist")
    local rule_id = node.id("rule")
    local glue_id = node.id("glue")
    local kern_id = node.id("kern")
    local whatsit_id = node.id("whatsit")
    local user_defined_subtype = node.subtype("user_defined")

    --[[ Return a glue node's actual size after its containing box has applied
    stretch or shrink. The fallback supports older LuaTeX node libraries. ]]
    local function effective_glue(n, parent)
      if node.effective_glue then
        return node.effective_glue(n, parent)
      end
      return n.width
    end

    --[[ Add one tagged rule fragment to its physical segment. A segment key is
    the repeat occurrence plus absolute horizontal position, so the same
    repeat split into two columns on one page forms two independent groups.
    Keep both the geometric union and the uppermost rule: that rule becomes
    the single solid PDF rectangle emitted for this segment. ]]
    local function collect_rule(context, n, x, baseline, parent)
      local repeat_id = node.has_attribute(n, attribute)
      if not repeat_id then
        return
      end
      context.sequence = context.sequence + 1
      local key = tostring(repeat_id) .. ":" .. tostring(x)
      local group = context.groups[key]
      local top = baseline - n.height
      local bottom = baseline + n.depth
      local normal_height = node.has_attribute(n, height_attribute) or n.height
      if not group then
        group = { top = top, bottom = bottom, first = n,
                  first_parent = parent, baseline = baseline, rules = {},
                  normal_height = normal_height,
                  repeat_id = repeat_id, last_sequence = context.sequence,
                  has_start = false, has_end = false }
        context.groups[key] = group
      else
        if top < group.top then
          group.top = top
          group.first = n
          group.first_parent = parent
          group.baseline = baseline
          group.normal_height = normal_height
        end
        if bottom > group.bottom then
          group.bottom = bottom
        end
        group.last_sequence = context.sequence
      end
      if node.has_attribute(n, start_attribute) then
        group.has_start = true
      end
      table.insert(group.rules, n)
    end

    --[[ Record a semantic end-repeat marker in traversal order. Its physical
    group is resolved after traversal because the zero-size marker has no
    useful horizontal coordinate of its own. ]]
    local function collect_end_marker(context, n)
      local repeat_id = node.has_attribute(n, attribute)
      if repeat_id and node.has_attribute(n, end_attribute) then
        context.sequence = context.sequence + 1
        table.insert(context.end_markers,
                     { repeat_id = repeat_id, sequence = context.sequence })
      end
    end

    local walk_box

    --[[ Traverse a horizontal list while tracking the absolute x coordinate
    and baseline. Nested boxes are visited recursively; glue must use its final
    stretched or shrunk width to keep column positions exact. ]]
    local function walk_hlist(list, x, baseline, parent, context)
      local cursor = x
      for n in node.traverse(list) do
        if n.id == rule_id then
          collect_rule(context, n, cursor, baseline, parent)
        elseif n.id == hlist_id or n.id == vlist_id then
          walk_box(n, cursor, baseline + n.shift, context)
        elseif n.id == whatsit_id and n.subtype == user_defined_subtype then
          collect_end_marker(context, n)
        end
        if n.id == glue_id then
          cursor = cursor + effective_glue(n, parent)
        elseif n.id == kern_id then
          cursor = cursor + n.kern
        elseif n.width then
          cursor = cursor + n.width
        end
      end
    end

    --[[ Traverse a vertical list from its absolute top edge. Box heights,
    depths, shifts, glue, and kerns advance the physical y position used to
    calculate each rule fragment's top, bottom, and baseline. ]]
    local function walk_vlist(list, x, top, parent, context)
      local cursor = top
      for n in node.traverse(list) do
        if n.id == rule_id then
          collect_rule(context, n, x, cursor + n.height, parent)
          cursor = cursor + n.height + n.depth
        elseif n.id == hlist_id or n.id == vlist_id then
          walk_box(n, x + n.shift, cursor + n.height, context)
          cursor = cursor + n.height + n.depth
        elseif n.id == glue_id then
          cursor = cursor + effective_glue(n, parent)
        elseif n.id == kern_id then
          cursor = cursor + n.kern
        elseif n.id == whatsit_id and n.subtype == user_defined_subtype then
          collect_end_marker(context, n)
        end
      end
    end

    --[[ Dispatch traversal using the reference-point convention of each box
    type. Horizontal boxes receive a baseline; vertical boxes receive a
    baseline and convert it to their top edge before walking their list. ]]
    walk_box = function(box, x, baseline, context)
      if box.id == hlist_id then
        walk_hlist(box.list, x, baseline, box, context)
      elseif box.id == vlist_id then
        walk_vlist(box.list, x, baseline - box.height, box, context)
      end
    end

    --[[ Insert one zero-width overlay box immediately before the retained
    solid rule. Its copied rule inherits width, color state, direction, and
    other backend properties, while the wrapper shift positions the short dash
    at the requested vertical interval without affecting TeX layout. ]]
    local function add_dash(group, top, bottom)
      local dash = node.copy(group.first)
      dash.height = bottom - top
      dash.depth = 0
      local wrapper = node.new(hlist_id)
      wrapper.width = 0
      wrapper.height = 0
      wrapper.depth = 0
      wrapper.dir = group.first_parent.dir
      wrapper.shift = bottom - group.baseline
      wrapper.list = dash
      group.first_parent.list = node.insert_before(
        group.first_parent.list, group.first, wrapper)
    end

    --[[ Associate each semantic end marker with the latest preceding physical
    segment of the same repeat on this shipped page. Earlier segments lack an
    end marker and are therefore known to continue on another column or page.
    Traversal order disambiguates multiple columns at the same repeat nesting
    level. ]]
    local function mark_ended_groups(context)
      for _, marker in ipairs(context.end_markers) do
        local candidate = nil
        for _, group in pairs(context.groups) do
          if group.repeat_id == marker.repeat_id
             and group.last_sequence < marker.sequence
             and (not candidate
                  or group.last_sequence > candidate.last_sequence) then
            candidate = group
          end
        end
        if candidate then
          candidate.has_end = true
        end
      end
    end

    --[[ Add two outward-facing dashes only at split boundaries. On an incoming
    segment, reset the solid rule to the normal first-line height and place the
    dashes above it. On an outgoing segment, preserve the normal bottom and
    place the dashes below it. Genuine repeat endpoints stay solid and receive
    no continuation marks. ]]
    local function add_continuation_dashes(group)
      local dash = tex.dimen.ulRepeatBarContinuationDashLength
      local gap = tex.dimen.ulRepeatBarContinuationDashGap
      if not group.has_start then
        local normal_top = group.baseline - group.normal_height
        group.top = normal_top
        add_dash(group, normal_top - 2 * dash - 2 * gap,
                        normal_top - dash - 2 * gap)
        add_dash(group, normal_top - dash - gap, normal_top - gap)
      end
      if not group.has_end then
        local normal_bottom = group.bottom
        add_dash(group, normal_bottom + gap,
                        normal_bottom + dash + gap)
        add_dash(group, normal_bottom + dash + 2 * gap,
                        normal_bottom + 2 * dash + 2 * gap)
      end
    end

    --[[ Shipout entry point: discover physical repeat segments, resolve their
    semantic endpoints, add continuation cues, then enlarge one fragment to
    cover the whole segment and zero all remaining fragments. LuaTeX omits
    zero-sized rules, leaving one solid PDF rectangle plus any break dashes. ]]
    local function coalesce_repeat_bars(head)
      local context = { groups = {}, end_markers = {}, sequence = 0 }
      walk_box(head, 0, head.height, context)
      mark_ended_groups(context)
      for _, group in pairs(context.groups) do
        add_continuation_dashes(group)
        group.first.height = group.baseline - group.top
        group.first.depth = group.bottom - group.baseline
        for _, rule in ipairs(group.rules) do
          if not (rule == group.first) then
            rule.width = 0
            rule.height = 0
            rule.depth = 0
          end
        end
      end
      return true
    end

    luatexbase.add_to_callback(
      "pre_shipout_filter", coalesce_repeat_bars, "ulsbs.repeatbars")
  }
  \def\ulsbs@rep@tagrule#1#2#3#4{%
    \begingroup%
      \attribute\ulsbs@rep@attribute=\csname ulsbs@rep@id@#1\endcsname\relax%
      \attribute\ulsbs@rep@heightattribute=\number#3\relax%
      \ifnum#2=1\relax%
        \attribute\ulsbs@rep@startattribute=1\relax%
      \fi%
      #4%
    \endgroup%
  }
  \def\ulsbs@rep@endmarker{%
    \begingroup%
      \attribute\ulsbs@rep@attribute=\csname ulsbs@rep@id@\the\ulsbs@rep@level\endcsname\relax%
      \attribute\ulsbs@rep@endattribute=1\relax%
      \directlua{%
        local marker = node.new("whatsit", "user_defined")
        marker.type = 100
        marker.value = 0
        node.write(marker)
      }%
    \endgroup%
  }
\else
  % Inactive fallback branch: the public engine guard rejects non-Lua engines
  % before this point. Its per-line fragment drawing is not a supported backend;
  % the Lua branch above owns coalescing and page/column continuation dashes.
  \PackageInfo{ulsbs}{Non-Lua engine: repeat bars use per-line fragments;^^J%
    single-object bars and break continuation dashes require LuaTeX}%
  \def\ulsbs@rep@tagrule#1#2#3#4{#4}%
  \let\ulsbs@rep@endmarker\relax
\fi

% Scratch registers:
\newlength\ulsbs@tmp@rep@allbarswidth
\newcount\ulsbs@tmp@rep@prevlinestoreach
\newdimen\ulsbs@tmp@rep@barhtbase
\newdimen\ulsbs@tmp@rep@normalbarhtbase

% Draw one line repetition bar (fragment) for current lyric line. Called
% repetitiously from \ulsbs@rep@drawbars.
\newcommand{\ulsbs@rep@drawbars@iter}[1]{%
  \rlap{%
    \ulIfBool{g__ulsbs_repeat_cont_prop}{#1}{% for the repeat started on earlier lyric line
      % If current bar was started on earlier lyric line (par), increase the
      % current line's repeat bar height to reach through the gap
      \advance\ulsbs@tmp@rep@barhtbase by \ulRepeatBarContinuingOverlap\relax
      % If previous lyric line (par) was (long and) wrapped to more than one
      % line, make the current line's repeat bar higher to reach through
      % them all.
      \ifnum\ulsbs@prevparlines>1\relax%
        \ulsbs@tmp@rep@prevlinestoreach=\ulsbs@prevparlines%
        \advance\ulsbs@tmp@rep@prevlinestoreach by -1\relax%
        \advance\ulsbs@tmp@rep@barhtbase by
         \dimexpr \baselineskip * \numexpr\ulsbs@tmp@rep@prevlinestoreach\relax\relax%
      \fi%
      % Draw the repeat bar with smash to take no vertical space
      \ulsbs@rep@tagrule{#1}{0}{\ulsbs@tmp@rep@normalbarhtbase}{\smash{%
        \vrule\@width\ulRepeatBarWidth%
              \@height\ulsbs@tmp@rep@barhtbase%
              \@depth\ulRepeatBarDepth%
      }}%
    }{%
      % We are on the first line of the repeat: smash or no?
      \ulsbs@rep@tagrule{#1}{1}{\ulsbs@tmp@rep@normalbarhtbase}{\smash{%
        \vrule\@width\ulRepeatBarWidth%
              \@height\ulsbs@tmp@rep@barhtbase%
              \@depth\ulRepeatBarDepth%
      }}%
    }%
    \ulBoolSetTrue{g__ulsbs_repeat_cont_prop}{#1}% The bar at this nesting level has been started
  }%
  \kern\ulRepeatBarWidth%
  \kern\ulRepeatBarGap%
  \addtolength{\ulsbs@tmp@rep@allbarswidth}{\ulRepeatBarWidth}%
  \addtolength{\ulsbs@tmp@rep@allbarswidth}{\ulRepeatBarGap}%
}

% Sets \ulsbs@tmp@rep@barhtbase to good height for repeat bars in this spot
\def\ulsbs@rep@setbarhtbase{%
  \ifulChorded%
    \global\ulsbs@tmp@rep@barhtbase=\baselineskip%
    \global\advance\ulsbs@tmp@rep@barhtbase \ulRepeatBarHeightAdjustmentWithChords\relax%
  \else%
    \global\settoheight{\ulsbs@tmp@rep@barhtbase}{\vphantom{A}}%
    \global\advance\ulsbs@tmp@rep@barhtbase \ulRepeatBarHeightAdjustmentNoChords\relax%
  \fi%
}

% Draw all repetition bars (fragments) for the current lyric line.
\def\ulsbs@rep@drawbars{%
  {% block to contain color
    \color{ulRepetitionSignColor}%
    \ulsbs@rep@setbarhtbase%
    \ulsbs@tmp@rep@normalbarhtbase=\ulsbs@tmp@rep@barhtbase%
    \setlength{\ulsbs@tmp@rep@allbarswidth}{0pt}%
    % Call \ulsbs@rep@drawbars@iter for each repeat level
    \ulRepeatTimes{\ulsbs@rep@level}{\ulsbs@rep@drawbars@iter}%
    \ifdim\ulsbs@tmp@rep@allbarswidth<\ulContentIndentWidth%
      \kern\dimexpr\ulContentIndentWidth-\ulsbs@tmp@rep@allbarswidth\relax%
    \fi%
  }%
}

% === Inline repeat marks ===

% \lrep and \rrep inline repetition mark rewrites:
% colorize, have only one bar, use same height and depth as line repeats
\DeclareDocumentCommand\lrep{}{%
  {%
    \color{ulRepetitionSignColor}%
    \ulsbs@rep@setbarhtbase%
    \vrule\@width1.618034\ulRepeatBarWidth%
          \@height\ulsbs@tmp@rep@barhtbase%
          \@depth\ulRepeatBarDepth%
    \ifulChorded%
      \rlap{\raisebox{\ulChordLineBaselineSkip}{:}}%
    \fi%
    :\kern.25ex%
  }%
}
\DeclareDocumentCommand\rrep{}{%
  {%
    \color{ulRepetitionSignColor}%
    \ulsbs@rep@setbarhtbase%
    \kern.25ex%
    \ifulChorded%
      \rlap{\raisebox{\ulChordLineBaselineSkip}{:}}%
    \fi%
    :%
    \vrule\@width1.618034\ulRepeatBarWidth%
          \@height\ulsbs@tmp@rep@barhtbase%
          \@depth\ulRepeatBarDepth%
  }%
}
% Colorize \rep and use our default font's Unicode × (Noto supports it)
\DeclareDocumentCommand\rep{m}{%
  {\color{ulRepetitionSignColor}(×#1)}%
}

% Use this instead of \rep to signify number of repeats on the first line
% of a line repeat. The parameter is the number of repetitions, as in \rep
% macro.
% Example:
%   \beginverse
%     \beginrep\prep{3}
%       lyric line
%     \endrep
%   \endverse
\newcommand{\prep}[1]{%
  \raisebox{\ifulsbs@baselineincreased{2ex}\else{1ex}\fi}{%
    {\color{ulRepetitionSignColor}\rep{#1}:}%
  }%
}


% === Images inside and outside songs ===

% \image?? macros include an image here. It is scaled so that it's width is
% a power of golden ratio conjugate of \linewidth. The optional parameter is
% the power [0..7] and if not given, defaults to 1. Value 0 will scale the
% image to maximum size, so it's width is \linewidth. The mandatory parameter
% is the image file name without path. Put the image in content/img (or other
% path specified by \graphicspath above). These commands can be used within and
% outside of songs.
%
%   - \imagel puts the image exactly at the current position
%   - \imager pushes the image to the right
%   - \imagec centers the image horizontally
%   - \imagecc centers the image horizontally and vertically
%   - \imagecb centers the image horizontally and pushes it to the bottom of the page
%   - \imagelc centers the image vertically
%   - \imagerc pushes the image to the right and centers it vertically
%   - \imagerb pushes the image to the right and bottom of page
%
% Example: \imagecc[2]{nicepic.png}
%   This scales the image width to 0.618034^2 * \linewidth and centers it both
%   horizontally and vertically in the space available.

\newcommand{\imagel}[2][1]{%
  \ulsbs@setgrcwidth[#1]%
  \includegraphics[width=\ulsbs@grcwidth]{#2}%
}

\newcommand{\imager}[2][1]{%
  \hfill\imagel[#1]{#2}%
}

\newcommand{\imagec}[2][1]{%
  \begin{center}%
    \imagel[#1]{#2}%
  \end{center}%
}

\newdimen\ulsbs@grcwidth% Set by \ulsbs@setgrcwidth and used in \imagel.

% Sets \ulsbs@grcwidth to hold a power of golden ratio conjugate (0.618034^n)
% Optional parameter (given within []) is the exponent as integer in
% [0..7] and if omitted, defaults to 1.
% Used in \imagel.
% (I know this is an idiotic way to produce these, but oh well -- LaTeX...)
\newcommand{\ulsbs@setgrcwidth}[1][1]{%
  \IfEq{#1}{0}{\setlength\ulsbs@grcwidth{1\linewidth}}{}% 1
  \IfEq{#1}{1}{\setlength\ulsbs@grcwidth{.618034\linewidth}}{}% 0.618034
  \IfEq{#1}{2}{\setlength\ulsbs@grcwidth{.381966\linewidth}}{}% 0.618034^2
  \IfEq{#1}{3}{\setlength\ulsbs@grcwidth{.236067\linewidth}}{}% 0.618034^3
  \IfEq{#1}{4}{\setlength\ulsbs@grcwidth{.145898\linewidth}}{}% 0.618034^4
  \IfEq{#1}{5}{\setlength\ulsbs@grcwidth{.090169\linewidth}}{}% 0.618034^5
  \IfEq{#1}{6}{\setlength\ulsbs@grcwidth{.055728\linewidth}}{}% 0.618034^6
  \IfEq{#1}{7}{\setlength\ulsbs@grcwidth{.034441\linewidth}}{}% 0.618034^7
}

% === Melody blocks and note hints ===

% Melody blocks display transposition-aware encircled note hints in a
% chord definition: \[<C D;E F @ .3em>Am].  Pitches must be uppercase for
% chord transposition mechanism.  `_` advances one empty note slot, `/`
% renders an unpitched circled slash and advances one slot, and `*` marks the
% current slot with a beat.  Negative offsets may protrude left of the shared
% anchor but intentionally never reduce the annotation's rightward advance.
% A leading `!` inside the block renders normally but makes the melody layers
% zero-advance and disables the whitespace minimum for that annotation.
%
% \ulMelodyPrimaryPosition{normal|low},
% \ulMelodySecondaryPosition{above|below|same}, and
% \ulMelodyStyleMapping{normal|swapped} are scoped policies. \ulShowNotes,
% \noteson/\notesoff, \ulShowBeats, and \beatson/\beatsoff remain in effect.

% --- Public melody appearance and layout configuration ---
% Define providecommand defaults before loading or renew afterward. Factors and
% font hooks expand during drawing, not during this declaration phase. Select
% scoped lane/style policies with the public commands below, not private flags.

% Setup the style for the melody note name "text". Renew this macro in the
% beginning of your document to set custom style. This will be called each
% time the melody note circle is drawn. This can be set for individual notes,
% too. If left empty, \scriptsize\mdseries\ulSansHeavyFont will be used.
\providecommand{\ulMelodySymbolStyle}{}

% Setup the style for the small tags put in front of melody note circles. This
% ought to just set a very small font size.
\providecommand{\ulMelodyTagStyle}{\fontsize{3.5pt}{4.5pt}\selectfont}

% Small tag text to be put in front of normal melody note circles. Does not take
% space.
\providecommand{\ulMelodyTagText}{}

% Small tag text to be put in front of alternatively styled melody note circles.
% Does not take space.
\providecommand{\ulMelodyAltTagText}{}

% Factor for the tag text for melody notes is pushed towards the right to be
% closer to the melody note circle. This is relative to 1ex of the melody note
% font, not the font setup in \ulMelodyTagStyle
\providecommand{\ulMelodyTagHorizontalAdjustmentFactor}{.1}

% Factor for the tag text for melody notes is pushed upwards.
% This is relative to 1ex of the melody note font, not the font setup
% in \ulMelodyTagStyle.
\providecommand{\ulMelodyTagVerticalAdjustmentFactor}{.8}

% Factor for the height of the normal melody notes from chord baseline.
% This is relative to 1 ex of the current font: \ulChordFont when called from
% within chord definition as it is meant to.
\providecommand{\ulMelodyNormalHeightFactor}{1.85}

% Factor for the height of the low melody note variant from chord baseline.
% This is relative to 1 ex of the current font: \ulChordFont when called from
% within chord definition as it is meant to.
% Used by the scoped low melody lanes.
\providecommand{\ulMelodyLowHeightFactor}{.3}

% Factor for the height of the high melody note variant from chord baseline.
% This is relative to 1 ex of the current font: \ulChordFont when called from
% within chord definition as it is meant to.
% Used by the high secondary melody lane.
\providecommand{\ulMelodyHighHeightFactor}{3.4}

% Factor for the lane below the low/chord-level melody lane. With the default
% values this continues the same 1.55ex separation used by high/normal/low.
% Selecting primary=low and secondary=below may intentionally overlap lyrics.
\providecommand{\ulMelodyLowestHeightFactor}{-1.25}

% If a visible chord-line annotation is followed by a literal source space,
% reserve at least this much horizontal advance. Wider annotations are
% unchanged. Relative units are evaluated in \ulLyricFontStyle; set to 0pt to disable.
\providecommand{\ulChordWhitespaceMinimumWidth}{.8ex}


% Melody blocks keep musical roles separate from their visual placement and
% styling.  These assignments are deliberately local, like ordinary TeX font
% and color changes, so a verse or explicit group can override them.  `same`
% places secondary on the primary lane; paired voices intentionally overlap.
\newif\ifulsbs@melodyprimarylow\ulsbs@melodyprimarylowfalse
\newif\ifulsbs@melodysecondarybelow\ulsbs@melodysecondarybelowfalse
\newif\ifulsbs@melodysecondarysame\ulsbs@melodysecondarysamefalse
\newif\ifulsbs@melodyswapped\ulsbs@melodyswappedfalse
\newcommand{\ulMelodyPrimaryPosition}[1]{%
  \ifstrequal{#1}{normal}{\ulsbs@melodyprimarylowfalse}{%
    \ifstrequal{#1}{low}{\ulsbs@melodyprimarylowtrue}{%
      \PackageError{ulsbs}{Invalid melody primary position `#1'}%
        {Use \string\ulMelodyPrimaryPosition\{normal\} or \{low\}.}%
    }%
  }%
}
\newcommand{\ulMelodySecondaryPosition}[1]{%
  \ifstrequal{#1}{above}{\ulsbs@melodysecondarybelowfalse\ulsbs@melodysecondarysamefalse}{%
    \ifstrequal{#1}{below}{\ulsbs@melodysecondarybelowtrue\ulsbs@melodysecondarysamefalse}{%
      \ifstrequal{#1}{same}{\ulsbs@melodysecondarybelowfalse\ulsbs@melodysecondarysametrue}{%
        \PackageError{ulsbs}{Invalid melody secondary position `#1'}%
          {Use \string\ulMelodySecondaryPosition\{above\}, \{below\}, or \{same\}.}%
      }%
    }%
  }%
}
\newcommand{\ulMelodyStyleMapping}[1]{%
  \ifstrequal{#1}{normal}{\ulsbs@melodyswappedfalse}{%
    \ifstrequal{#1}{swapped}{\ulsbs@melodyswappedtrue}{%
      \PackageError{ulsbs}{Invalid melody style mapping `#1'}%
        {Use \string\ulMelodyStyleMapping\{normal\} or \{swapped\}.}%
    }%
  }%
}

% Prints the pretag for melody note circle, if one exists
\newcommand{\ulsbs@mntag}{%
  \begingroup%
    \hspace{\dimexpr\ulMelodyTagHorizontalAdjustmentFactor ex\relax}%
    \raisebox{\dimexpr\ulMelodyTagVerticalAdjustmentFactor ex\relax}{%
        \llap{\ulMelodyTagStyle\ifulsbs@altmnstyle\ulMelodyAltTagText\else\ulMelodyTagText\fi}%
    }%
  \endgroup%
}

% Base melody-note symbol style, followed by \ulMelodySymbolStyle:
\newcommand{\ulsbs@mnsymbolstyle}{%
  \scriptsize\mdseries\ulSansHeavyFont%
  \ifulsbs@altmnstyle%
    \color{ulMelodyNoteAltColor}%
  \else%
    \color{ulMelodyNoteColor}%
  \fi%
  \ulMelodySymbolStyle%
}

% Sharp and flat symbols for note circles: adjust their height and kerning
% for a better fit within the circle.
\newcommand{\ulsbs@mnsharpsymbol}{\raise-.25ex\hbox{\textsuperscript{{\kern-0.05em\ulSymbolFont♯}}}}%


% Outputs an encircled melody note, internal
%   - optional parameter: rise the note above text (chord line) by this amount,
%                         defaults to \ulMelodyNormalHeightFactor ex
%   - mandatory parameter: the note, must be in UPPER CASE for transposing to
%     work
%   * Example usage: \ulsbs@note[0.5em]{C#}
%   * To take no horizontal space, call this macro within \makebox[0pt][l]{}
\NewDocumentCommand{\ulsbs@note}{O{\dimexpr\ulMelodyNormalHeightFactor ex\relax} m}{}

% --- Melody-block parser state ---
%
% The syntax is parsed after the chord scanner collects one \[...] argument.
% Angle brackets retain their ordinary catcode and have no meaning elsewhere.
% Parsed primary and secondary items are stored as expl3 sequences so renderer
% layout is independent of the textual spelling (compact or space-separated).
% The one-token `!` modifier is dispatched separately below to avoid expanding
% active accidental tokens before they reach this content parser.
\newsavebox{\ulsbs@melodyprimarybox}
\newsavebox{\ulsbs@melodysecondarybox}
\newsavebox{\ulsbs@melodybeatbox}
\newsavebox{\ulsbs@melodylayerbox}
\newdimen\ulsbs@melodyslotwidth
\newdimen\ulsbs@melodyoffset
\newdimen\ulsbs@melodybeatwidth
\newdimen\ulsbs@melodybeatextent
\newdimen\ulsbs@melodycurrentextent
\newif\ifulsbs@annotationvisible
\newif\ifulsbs@annotationminimumdisabled
\newif\ifulsbs@melodyzeroadvance

\ExplSyntaxOn
\tl_new:N \l__ulsbs_melody_primary_tl
\tl_new:N \l__ulsbs_melody_secondary_tl
\tl_new:N \l__ulsbs_melody_offset_tl
\tl_new:N \l__ulsbs_melody_at_tl
\seq_new:N \l__ulsbs_melody_parts_seq
\seq_new:N \l__ulsbs_melody_primary_seq
\seq_new:N \l__ulsbs_melody_secondary_seq
\seq_new:N \l__ulsbs_melody_lex_seq
\cs_generate_variant:Nn \seq_set_split:Nnn { NVn, NVV }
\cs_generate_variant:Nn \str_case:nnF { en }
\cs_generate_variant:Nn \regex_match:nnT { nV }
% Report parser errors with the complete original block for useful diagnostics.
\cs_new_protected:Npn \__ulsbs_melody_error:n #1
  { \PackageError{ulsbs}{Malformed~melody~block~`\tl_use:N\l__ulsbs_melody_raw_tl'}{#1} }
\tl_new:N \l__ulsbs_melody_raw_tl
\tl_new:N \l__ulsbs_melody_content_tl
% Parse separators first: one optional @ dimension and one optional ; voice
% separator. The remaining voice fields are then tokenized independently.
\cs_new_protected:Npn \__ulsbs_melody_parse:n #1
 {
  \tl_set:Nn \l__ulsbs_melody_raw_tl {#1}
  \tl_set:Nn \l__ulsbs_melody_content_tl {#1}
  \tl_trim_spaces:N \l__ulsbs_melody_content_tl
  \regex_match:nVT { @ \s* \Z } \l__ulsbs_melody_content_tl
   {\__ulsbs_melody_error:n {The~@~separator~must~be~followed~by~a~TeX~dimension.}}
  \regex_match:nVT { @ .* @ } \l__ulsbs_melody_content_tl
   {\__ulsbs_melody_error:n {A~melody~block~may~contain~only~one~@~offset.}}
  \tl_set:Nx \l__ulsbs_melody_at_tl {\char_generate:nn {64} {12}}
  \seq_set_split:NVV \l__ulsbs_melody_parts_seq \l__ulsbs_melody_at_tl \l__ulsbs_melody_content_tl
  \int_compare:nNnTF {\seq_count:N \l__ulsbs_melody_parts_seq} > {2}
   {\__ulsbs_melody_error:n {A~melody~block~may~contain~only~one~@~offset.}}
   {
    \seq_pop_left:NN \l__ulsbs_melody_parts_seq \l__ulsbs_melody_primary_tl
    \tl_trim_spaces:N \l__ulsbs_melody_primary_tl
    \tl_clear:N \l__ulsbs_melody_offset_tl
    \seq_if_empty:NTF \l__ulsbs_melody_parts_seq
     {\tl_if_in:VnT \l__ulsbs_melody_raw_tl {@}
       {\__ulsbs_melody_error:n {The~@~separator~must~be~followed~by~a~TeX~dimension.}}}
     { \seq_pop_left:NN \l__ulsbs_melody_parts_seq \l__ulsbs_melody_offset_tl
       \tl_trim_spaces:N \l__ulsbs_melody_offset_tl
